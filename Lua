-- STREAMING_CHUNK:Defining core object targeting and raycasting logic...
local function findTargetObject()
local mouse = player:GetMouse()
local targetPart = mouse.Target
if targetPart and not targetPart.Anchored and targetPart:IsA("BasePart") then
-- Ensure the part is not part of the player's character
if not targetPart:IsDescendantOf(character) then
return targetPart
end
end
return nil
end
-- STREAMING_CHUNK:Implementing the physics loop to keep object in front of character...
local function startPullingLoop()
if connection then connection:Disconnect() end
connection = RunService.RenderStepped:Connect(function()
if not isPulling or not currentTarget or not currentTarget.Parent then
return
end
-- Calculate target CFrame position in front of HumanoidRootPart
local rootCFrame = humanoidRootPart.CFrame
local desiredCFrame = rootCFrame + (rootCFrame.LookVector * pullDistance)
-- Apply smooth physics movement to the part
local currentCF = currentTarget.CFrame
local targetCF = CFrame.new(desiredCFrame.Position) * currentCF.Rotation
-- Set velocity to zero to avoid erratic physics bouncing
if currentTarget:IsA("BasePart") then
currentTarget.Velocity = Vector3.new(0, 0, 0)
currentTarget.RotVelocity = Vector3.new(0, 0, 0)
currentTarget.CFrame = currentCF:Lerp(targetCF, 0.3)
end
end)
end
-- STREAMING_CHUNK:Setting up UI event listeners and button actions...
toggleButton.MouseButton1Click:Connect(function()
isPulling = not isPulling
if isPulling then
currentTarget = findTargetObject()
if currentTarget then
toggleButton.Text = "Toggle Puller: ON"
toggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
startPullingLoop()
else
isPulling = false
toggleButton.Text = "No Part Found!"
task.delay(1, function()
if not isPulling then
toggleButton.Text = "Toggle Puller: OFF"
end
end)
end
else
toggleButton.Text = "Toggle Puller: OFF"
toggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 127)
currentTarget = nil
if connection then
connection:Disconnect()
connection = nil
end
end
end)
